{
  "pod_kombucha": {
    "nome": "POD Kombucha",
    "ativo": true,
    "plataformas": {
      "google_ads": {
        "ativo": false,
        "_comentario": "API: aguardando customer_id. Dados históricos via Sheets migrados.",
        "gads_customer_id": null,
        "loader": "google_ads.loader",
        "loader_fn": "carregar_gads",
        "loader_params": {
          "dias": 8
        },
        "tabela_db": "pod_kombucha_gads_diario"
      },
      "meta_ads": {
        "ativo": true,
        "meta_account_id": "act_324906945710366",
        "meta_token_env": "META_POD_ACCESS_TOKEN",
        "loader": "meta_ads.loader",
        "loader_fn": "carregar_meta",
        "loader_params": {
          "dias": 8
        },
        "tabela_db": "pod_kombucha_meta_ads_diario"
      },
      "shopify": {
        "ativo": true,
        "store_env": "SHOPIFY_POD_STORE",
        "token_env": "SHOPIFY_POD_TOKEN",
        "loader": "shopify.sync",
        "loader_fn": "carregar_shopify",
        "loader_params": {
          "dias": 8,
          "cliente_key": "pod_kombucha"
        },
        "tabela_db": "pod_kombucha_shopify_diario"
      }
    },
    "builder": "relatorio.builder_pod",
    "builder_semanal": "gerar_relatorio_semanal_pod",
    "builder_mensal": "gerar_relatorio_mensal_pod",
    "builder_diario": "gerar_relatorio_diario",
