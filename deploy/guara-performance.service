[Unit]
Description=Agente de Performance + Landing Pages da Guará (Slack HTTP em 127.0.0.1:8102)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=guara
WorkingDirectory=/home/guara/guara-performance/agente-performance
EnvironmentFile=/home/guara/guara-performance/agente-performance/.env
# O código antigo faz sys.path.insert em /home/ubuntu/.openclaw/workspace; aqui o PYTHONPATH supre isso sem patch.
Environment=PYTHONPATH=/home/guara/guara-performance/transcricao:/home/guara/guara-performance
ExecStart=/home/guara/guara-performance/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8102
Restart=always
RestartSec=5
TimeoutStopSec=20
SyslogIdentifier=guara-performance
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/guara/guara-performance
# Regras do VPS da FEQ: se vazar memória, morre este serviço, não a Atena.
MemoryHigh=250M
MemoryMax=300M
CPUQuota=60%
Nice=5

[Install]
WantedBy=multi-user.target
