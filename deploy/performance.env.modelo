# /home/guara/guara-performance/agente-performance/.env  (dono guara, permissão 600)
# Preencha os segredos novos. Linha vazia = recurso desligado. Os ajustes finos (cache, timeouts) têm padrão no código.

# ── Obrigatórios para o bot responder no Slack ──
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# opcional: Claude só como reserva se o Gemini falhar
ANTHROPIC_API_KEY=

# ── Fontes de dados (syncs) ──
WINDSOR_API_KEY=
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_POD_STORE=
SHOPIFY_POD_TOKEN=
SHOPIFY_BOTICA_STORE=
SHOPIFY_BOTICA_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Notion (cards e relatórios), Gemini (imagens das LPs), BigQuery ──
NOTION_TOKEN=
NOTION_API_KEY=
# LLM principal (bot, SQL, insights, transcrição, LPs, imagens)
GEMINI_API_KEY=
# Caminho de um JSON de conta de serviço NOVA dentro de /home/guara/guara-performance (ex.: .../agente-performance/data/gcp.json)
GOOGLE_APPLICATION_CREDENTIALS=
# Conta só-leitura (BigQuery Data Viewer + Job User) usada por todas as leituras, inclusive o SQL gerado pelo bot
BQ_READONLY_CREDENTIALS=
# Teto de bytes por query (padrão 2 GB)
# BQ_MAX_BYTES=2000000000

# ── Canais do Slack ──
SLACK_CHANNEL=
SLACK_ALERT_CHANNEL=
SLACK_ATAS_CHANNEL=
SLACK_IMAGE_GEN_CHANNEL=
FLORA_SLACK_CHANNEL=

# ── Transcrição, dashboard e backup ──
# Transcrição: JSON novo da conta de serviço em /home/guara/guara-performance/transcricao/credentials/gdrive-service-account.json
MONGODB_URI=
DASHBOARD_INGEST_TOKEN=
# Bucket do GCS para o backup diário (usa GOOGLE_APPLICATION_CREDENTIALS)
GUARA_BACKUP_BUCKET=

# Token da API REST interna (header X-API-Token). Vazio = API fechada; só /health e /slack/events abertos
API_TOKEN=

# Modelos (um lugar só; vazio = padrão do código)
# GEMINI_MODEL=gemini-3.8-flash            # tudo que é texto
# GEMINI_MODEL_LP=                          # landing pages (vazio = GEMINI_MODEL)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# CLAUDE_MODEL=claude-haiku-4-5-20251001    # só no fallback
